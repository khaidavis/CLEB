# Copy this to .env and adjust as needed:  cp .env.example .env
# Database (read by docker-compose.yml)
POSTGRES_DB=platform
POSTGRES_USER=platform_user
POSTGRES_PASSWORD=myS3cret_platform_pw
POSTGRES_PORT=5432

# Backend auth secret (override in production)
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-bytes
